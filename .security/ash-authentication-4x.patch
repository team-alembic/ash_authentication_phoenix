+++ b/lib/ash_authentication/strategies/password.ex
@@ -115,6 +115,7 @@ defmodule AshAuthentication.Strategy.Password do
             sign_in_action_name: nil,
             sign_in_enabled?: true,
             sign_in_token_lifetime: 60,
+            sign_in_token_via_post?: false,
             sign_in_tokens_enabled?: false,
             sign_in_with_token_action_name: nil,
             __spark_metadata__: nil
@@ -150,6 +151,7 @@ defmodule AshAuthentication.Strategy.Password do
           sign_in_action_name: atom,
           sign_in_enabled?: boolean,
           sign_in_token_lifetime: pos_integer,
+          sign_in_token_via_post?: boolean,
           sign_in_tokens_enabled?: boolean,
           sign_in_with_token_action_name: atom,
           __spark_metadata__: Spark.Dsl.Entity.spark_meta()
diff --git a/lib/ash_authentication/strategies/password/dsl.ex b/lib/ash_authentication/strategies/password/dsl.ex
index cf42c61..af86a95 100644
--- a/lib/ash_authentication/strategies/password/dsl.ex
+++ b/lib/ash_authentication/strategies/password/dsl.ex
@@ -130,6 +130,23 @@ defmodule AshAuthentication.Strategy.Password.Dsl do
           doc:
             "A lifetime for which a generated sign in token will be valid, if `sign_in_tokens_enabled?`. Unit defaults to `:seconds`."
         ],
+        sign_in_token_via_post?: [
+          type: :boolean,
+          doc: """
+          Hand the sign in token to the `sign_in_with_token` route in a POST body rather than a query string.
+
+          The sign in token is a live credential. Presenting it establishes an authenticated session.
+          A query string is recorded by reverse proxies, CDNs, load balancers, full-URL telemetry and
+          browser history. A POST body is recorded by none of those. Enable this so that the token is
+          not written to any of them.
+
+          This needs a version of `ash_authentication_phoenix` that renders the form which performs the
+          POST. An older version ignores this option and keeps the query string. Defaults to `false` to
+          keep the existing route behaviour. It will default to `true` in the next major version.
+          """,
+          required: false,
+          default: false
+        ],
         sign_in_with_token_action_name: [
           type: :atom,
           doc: "The name to use for the sign in action.",
diff --git a/lib/ash_authentication/strategies/password/strategy.ex b/lib/ash_authentication/strategies/password/strategy.ex
index dd8418a..9dcff8c 100644
--- a/lib/ash_authentication/strategies/password/strategy.ex
+++ b/lib/ash_authentication/strategies/password/strategy.ex
@@ -47,6 +47,9 @@ defimpl AshAuthentication.Strategy, for: AshAuthentication.Strategy.Password do
 
   @doc false
   @spec method_for_phase(Password.t(), phase) :: Strategy.http_method()
+  def method_for_phase(strategy, :sign_in_with_token) when strategy.sign_in_token_via_post?,
+    do: :post
+
   def method_for_phase(_, phase) when phase in [:sign_in_with_token], do: :get
   def method_for_phase(_, _), do: :post
 
